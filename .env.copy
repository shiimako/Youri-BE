# Environment Variables Configuration
PORT=port_number_here
NODE_ENV=environment_here (development/production)

# Mongodb Atlas Credentials
MONGODB_URI=youri_mongodb_uri_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=youri_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=youri_cloudinary_api_key_here
CLOUDINARY_API_SECRET=youri_cloudinary_api_secret_here

# Redis Configuration
REDIS_URL=youri_redis_url_here

# Internal AI Service Configuration
INTERNAL_AI_SERVICE_URL=youri_internal_ai_service_url_here
INTERNAL_AI_API_KEY=youri_internal_ai_api_key_here

# Google OAuth Client ID
GOOGLE_CLIENT_ID=youri_google_client_id_here

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Email Admin Credentials (gunakan app password jika menggunakan Gmail dengan 2FA)
EMAIL_ADMIN=your_email_here
EMAIL_ADMIN_PASS=your_email_admin_pass_here (app password if using Gmail with 2FA)

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here